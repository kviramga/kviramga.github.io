/*
* InnovateHer Custom Style
* Based on MLH Boilerplate
*/

/* Fonts */
@import url('https://fonts.googleapis.com/css?family=Open+Sans:600,700&display=swap');
@import url('https://fonts.googleapis.com/css?family=Montserrat:400,700&display=swap');

/* Colors:
 * Pink Gradient: #F5699C → #FF7FA8
 * Dark Accent: #0F2C34
 */

* {
  font-family: 'Open Sans', sans-serif;
  font-weight: 600;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  background-color: #F5699C;
}

section {
  overflow-x: hidden;
}

/* Trust Badge */
#mlh-trust-badge {
  display: block;
  max-width: 100px;
  min-width: 60px;
  position: fixed;
  right: 50px;
  top: 0;
  width: 10%;
  z-index: 10000;
}

/* Hero Section */
.hero {
  background: linear-gradient(135deg, #F5699C, #FF7FA8);
  min-height: 110vh;
  position: relative;
}

.hero img {
  max-width: 400px;
}

.hero hr {
  border-top: 15px solid #0F2C34;
  margin: 0;
  position: relative;
  top: -14px;
}

.hero .wrapper {
  padding-top: 30vh;
  text-align: center;
}

.hero .wrapper h1 {
  background: rgba(255, 255, 255, 0.3);
  display: inline-block;
  font-size: 60px;
  font-weight: 800;
  letter-spacing: -2px;
  padding: 10px 30px;
  border-radius: 10px;
}

.hero .wrapper h2 {
  font-size: 28px;
  font-weight: 200;
}

.hero .wrapper h3 {
  font-size: 20px;
  font-weight: 200;
  padding-bottom: 35px;
}

.hero .buttons {
  margin: 40px 0;
}

.hero .buttons a {
  background: #fff;
  border: 10px solid #0F2C34;
  border-radius: 40px;
  color: #0F2C34;
  display: inline-block;
  font-family: 'Montserrat', sans-serif;
  font-size: 24px;
  font-weight: 700;
  padding: 10px 70px;
  text-decoration: none;
  text-transform: uppercase;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.hero .buttons a:hover,
.hero .buttons a:focus {
  background-color: #0F2C34;
  color: #fff;
  transform: scale(1.05);
  box-shadow: 0 0 10px rgba(255, 127, 168, 0.6);
}

.hero .buttons a:not(:last-child) {
  margin-right: 10px;
}

/* About Section */
.about {
  background-color: #fff0f5;
  padding: 130px 0;
  position: relative;
  text-align: center;
}

.about p {
  color: #0F2C34;
  font-weight: 600;
  font-size: 22px;
  line-height: 1.6em;
  letter-spacing: -0.3px;
  max-width: 800px;
  margin: auto;
}

.about p span {
  font-weight: 700;
  text-transform: uppercase;
}

/* Info Section */
.info {
  background-color: #ffffff;
  margin-top: 15px;
  padding: 100px 0;
  text-align: center;
}

.info .item {
  padding: 20px;
}

.info .item h1 {
  font-family: 'Montserrat', sans-serif;
  font-size: 48px;
  font-weight: 700;
  margin: 20px 0;
  color: #F5699C;
  letter-spacing: 1px;
  text-transform: uppercase;
}

.info .item img {
  max-width: 220px;
}

.info .item p {
  font-size: 20px;
}

/* FAQ Section */
.faq {
  background-color: #fff0f5;
  margin-top: 15px;
  padding: 100px 0;
  position: relative;
  text-align: center;
}

.faq h1 {
  font-family: 'Montserrat', sans-serif;
  font-weight: 700;
  font-size: 48px;
  color: #F5699C;
  margin: 30px 0;
}

.faq .question h2 {
  font-family: 'Montserrat', sans-serif;
  font-weight: 700;
  font-size: 24px;
  margin-top: 40px;
  position: relative;
}

.faq .question h2::after {
  content: "";
  display: block;
  width: 50px;
  height: 4px;
  background: #FF7FA8;
  margin: 10px auto;
  border-radius: 2px;
}

.faq .question hr {
  border-top: 8px solid #0F2C34;
  margin: 20px auto;
  width: 80px;
}

.faq .question p {
  font-size: 18px;
  line-height: 1.5em;
  max-width: 700px;
  margin: auto;
}

.faq img {
  margin-bottom: -2px;
  margin-top: 40px;
  width: 300px;
}

/* Footer Section */
.footer {
  background-color: #F5699C;
  color: #fff;
  padding: 30px 0;
  text-align: center;
}

.footer img {
  max-width: 250px;
  margin-bottom: 15px;
}

.footer h3 {
  font-family: 'Montserrat', sans-serif;
  font-size: 16px;
  font-weight: 400;
  line-height: 26px;
  margin: 0;
}

.footer h3 a {
  color: #fff;
  text-decoration: underline;
}

/* Responsive */
@media (max-width: 768px) {
  .hero .buttons a {
    border-width: 8px;
    display: block;
    font-size: 20px;
    margin: 5px auto;
    width: 80%;
  }

  .hero img {
    width: 250px;
  }

  .hero hr {
    border-top-width: 8px;
    top: -8px;
  }

  .about p,
  .faq .question p {
    font-size: 18px;
    padding: 0 20px;
  }
}
